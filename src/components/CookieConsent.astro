---
<div id="cookie-consent" class="cc-wrap" role="dialog" aria-labelledby="cc-title" hidden>
  <div class="cc-inner">
    <div class="cc-text">
      <strong id="cc-title">🍪 Cookie 使用聲明</strong>
      <p>本網站使用必要 cookie 維持登入狀態，未來可能加入 Google AdSense 個人化廣告 cookie。繼續使用即表示您同意；您可隨時於 <a href="/privacy">隱私政策</a> 了解詳情或撤回同意。</p>
    </div>
    <div class="cc-btns">
      <button type="button" id="cc-reject" class="cc-btn cc-btn-reject">僅接受必要</button>
      <button type="button" id="cc-accept" class="cc-btn cc-btn-accept">全部接受</button>
    </div>
  </div>
</div>

<script is:inline>
(function(){
  var KEY = 'tb_cc_v1';
  var state = null;
  try { state = localStorage.getItem(KEY); } catch(e) {}
  var el = document.getElementById('cookie-consent');
  if (!el) return;

  // Google Consent Mode v2 default (deny until user acts)
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  window.gtag = window.gtag || gtag;
  if (!state) {
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });
    el.hidden = false;
  } else {
    var granted = state === 'all';
    gtag('consent', 'default', {
      ad_storage: granted ? 'granted' : 'denied',
      ad_user_data: granted ? 'granted' : 'denied',
      ad_personalization: granted ? 'granted' : 'denied',
      analytics_storage: granted ? 'granted' : 'denied',
    });
  }

  function save(v) {
    try { localStorage.setItem(KEY, v); } catch(e) {}
    gtag('consent', 'update', {
      ad_storage: v === 'all' ? 'granted' : 'denied',
      ad_user_data: v === 'all' ? 'granted' : 'denied',
      ad_personalization: v === 'all' ? 'granted' : 'denied',
      analytics_storage: v === 'all' ? 'granted' : 'denied',
    });
    el.hidden = true;
  }
  document.getElementById('cc-accept')?.addEventListener('click', function(){ save('all'); });
  document.getElementById('cc-reject')?.addEventListener('click', function(){ save('essential'); });
})();
</script>

<style>
.cc-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 9999;
  background: rgba(15,23,42,.96);
  color: #f1f5f9;
  border-top: 2px solid #E8920A;
  padding: 1em;
  backdrop-filter: blur(6px);
}
.cc-inner {
  max-width: 1080px;
  margin: 0 auto;
  display: flex;
  gap: 1em;
  align-items: center;
  flex-wrap: wrap;
}
.cc-text { flex: 1 1 300px; font-size: .85em; line-height: 1.55; }
.cc-text strong { display: block; font-size: 1em; margin-bottom: .2em; color: #fff; }
.cc-text p { margin: 0; color: #cbd5e1; }
.cc-text a { color: #fbbf24; text-decoration: underline; }
.cc-btns { display: flex; gap: .5em; flex-shrink: 0; }
.cc-btn {
  padding: .55em 1.1em;
  border-radius: 6px;
  border: none;
  font-weight: 700;
  font-size: .85em;
  cursor: pointer;
  transition: background .15s, transform .1s;
}
.cc-btn:active { transform: translateY(1px); }
.cc-btn-reject { background: transparent; color: #cbd5e1; border: 1px solid #475569; }
.cc-btn-reject:hover { background: #1e293b; }
.cc-btn-accept { background: #E8920A; color: #fff; }
.cc-btn-accept:hover { background: #C2740A; }
@media (max-width: 640px) {
  .cc-btns { width: 100%; justify-content: flex-end; }
}
</style>
