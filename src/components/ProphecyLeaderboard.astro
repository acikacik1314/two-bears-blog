---
import { getProphetStats } from '../utils/prophetStats';

const allStats = await getProphetStats();
const stats = allStats.filter(s => s.postCount > 0);

const qualified = stats.filter(s => s.qualified);
const emerging = stats.filter(s => !s.qualified && s.verified > 0);
const noData = stats.filter(s => !s.qualified && s.verified === 0);

const MEDALS = ['🥇', '🥈', '🥉'];

const statsJson = JSON.stringify(stats.map(s => ({
  name: s.id, hits: s.hits, misses: s.misses, pending: s.pending,
  accuracy: s.accuracy, adjudicationRate: s.adjudicationRate,
  totalPredictions: s.totalPredictions, verified: s.verified, qualified: s.qualified,
})));

// Global default-order index (matches source sort)
const defaultOrder: Record<string, number> = {};
stats.forEach((s, i) => { defaultOrder[s.id] = i; });
---

<div class="lb-wrap">
  <div class="lb-header">
    <span class="lb-title">🏆 預言命中率排行榜</span>
    <a class="lb-link" href="/category/預言/">查看所有預言 →</a>
  </div>

  <p class="lb-reverify">🔍 命中須附查證依據才計分，整理進行中——數字還會繼續更新</p>

  {stats.length === 0 ? (
    <p class="lb-empty">尚無數據，在文章中加入 <code>predictions</code> 欄位後自動更新</p>
  ) : (
    <>
      <div class="lb-controls">
        <input type="search" class="lb-search" id="lb-search" placeholder="🔍 搜尋預言家名稱" aria-label="搜尋預言家" />
        <select class="lb-sort" id="lb-sort" aria-label="排序方式">
          <option value="default">預設（Wilson 分數）</option>
          <option value="accuracy">準確率高 → 低</option>
          <option value="hits">命中數多 → 少</option>
          <option value="adj">判定率高 → 低</option>
          <option value="posts">文章數多 → 少</option>
        </select>
      </div>

      {qualified.length > 0 && (
        <div class="lb-section">
          <div class="lb-section-head">
            <span class="lb-section-title">✅ 已判定預言家</span>
            <span class="lb-section-count">{qualified.length} 位（≥15 筆已判定）</span>
          </div>
          <div class="lb-table-wrap">
            <table class="lb-table">
              <thead>
                <tr>
                  <th>#</th><th>預言家</th><th class="lb-hide-mobile">文章</th>
                  <th>命中</th><th>失誤</th><th class="lb-hide-mobile">待驗</th>
                  <th>準確率</th><th>判定率</th>
                </tr>
              </thead>
              <tbody class="lb-tbody">
                {qualified.map((s, i) => (
                  <tr
                    class={`lb-row${i === 0 ? ' lb-top1' : i === 1 ? ' lb-top2' : i === 2 ? ' lb-top3' : ''}`}
                    data-name={s.id}
                    data-default={defaultOrder[s.id]}
                    data-accuracy={s.accuracy ?? -1}
                    data-hits={s.hitCount}
                    data-adj={s.adjudicationRate ?? -1}
                    data-posts={s.postCount}
                    title={`點擊查看 ${s.id} 的詳細預言`}
                  >
                    <td class="lb-rank">{i < 3 ? MEDALS[i] : i + 1}</td>
                    <td class="lb-name"><a class="lb-name-link" href={`/prophet/${encodeURIComponent(s.id)}`}>{s.id}</a></td>
                    <td class="lb-hide-mobile">{s.postCount}</td>
                    <td class="lb-hit">{s.hitCount > 0 ? `✅ ${s.hitCount}` : '—'}</td>
                    <td class="lb-miss">{s.missCount > 0 ? `❌ ${s.missCount}` : '0'}</td>
                    <td class="lb-hide-mobile lb-pend">{s.pendingCount > 0 ? `⏳ ${s.pendingCount}` : '—'}</td>
                    <td class="lb-acc">
                      {s.accuracy !== null ? (
                        <span class={s.accuracy >= 60 ? 'acc-good' : s.accuracy >= 40 ? 'acc-mid' : 'acc-low'}>{s.accuracy}%</span>
                      ) : (
                        <span class="acc-none">{s.reasonedHitCount}/{s.verified}</span>
                      )}
                    </td>
                    <td class="lb-adj">
                      {s.adjudicationRate !== null ? (
                        <><span class="adj-pct">{s.adjudicationRate}%</span><span class="adj-det">({s.verified}/{s.totalPredictions})</span></>
                      ) : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {emerging.length > 0 && (
        <details class="lb-section lb-collapsible" open>
          <summary class="lb-section-head">
            <span class="lb-section-title">🔬 樣本建置中</span>
            <span class="lb-section-count">{emerging.length} 位（已判定 &lt;15 筆）</span>
          </summary>
          <div class="lb-table-wrap">
            <table class="lb-table">
              <thead>
                <tr>
                  <th>#</th><th>預言家</th><th class="lb-hide-mobile">文章</th>
                  <th>命中</th><th>失誤</th><th class="lb-hide-mobile">待驗</th>
                  <th>準確率</th><th>判定率</th>
                </tr>
              </thead>
              <tbody class="lb-tbody">
                {emerging.map((s, i) => (
                  <tr class="lb-row" data-name={s.id} data-default={defaultOrder[s.id]}
                      data-accuracy={s.accuracy ?? -1} data-hits={s.hitCount}
                      data-adj={s.adjudicationRate ?? -1} data-posts={s.postCount}
                      title={`點擊查看 ${s.id} 的詳細預言`}>
                    <td class="lb-rank">{i + 1}</td>
                    <td class="lb-name"><a class="lb-name-link" href={`/prophet/${encodeURIComponent(s.id)}`}>{s.id}</a></td>
                    <td class="lb-hide-mobile">{s.postCount}</td>
                    <td class="lb-hit">{s.hitCount > 0 ? `✅ ${s.hitCount}` : '—'}</td>
                    <td class="lb-miss">{s.missCount > 0 ? `❌ ${s.missCount}` : '0'}</td>
                    <td class="lb-hide-mobile lb-pend">{s.pendingCount > 0 ? `⏳ ${s.pendingCount}` : '—'}</td>
                    <td class="lb-acc">
                      {s.accuracy !== null ? (
                        <span class={s.accuracy >= 60 ? 'acc-good' : s.accuracy >= 40 ? 'acc-mid' : 'acc-low'}>{s.accuracy}%</span>
                      ) : (
                        <span class="acc-none">{s.reasonedHitCount}/{s.verified}</span>
                      )}
                    </td>
                    <td class="lb-adj">
                      {s.adjudicationRate !== null ? (
                        <><span class="adj-pct">{s.adjudicationRate}%</span><span class="adj-det">({s.verified}/{s.totalPredictions})</span></>
                      ) : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}

      {noData.length > 0 && (
        <details class="lb-section lb-collapsible">
          <summary class="lb-section-head">
            <span class="lb-section-title">📥 尚未判定</span>
            <span class="lb-section-count">{noData.length} 位（無已判定樣本）</span>
          </summary>
          <div class="lb-table-wrap">
            <table class="lb-table">
              <thead>
                <tr>
                  <th>#</th><th>預言家</th><th class="lb-hide-mobile">文章</th>
                  <th>待驗</th><th>狀態</th>
                </tr>
              </thead>
              <tbody class="lb-tbody">
                {noData.map((s, i) => (
                  <tr class="lb-row" data-name={s.id} data-default={defaultOrder[s.id]}
                      data-accuracy={-1} data-hits={s.hitCount}
                      data-adj={-1} data-posts={s.postCount}
                      title={`點擊查看 ${s.id} 的詳細預言`}>
                    <td class="lb-rank">{i + 1}</td>
                    <td class="lb-name"><a class="lb-name-link" href={`/prophet/${encodeURIComponent(s.id)}`}>{s.id}</a></td>
                    <td class="lb-hide-mobile">{s.postCount}</td>
                    <td class="lb-pend">{s.pendingCount > 0 ? `⏳ ${s.pendingCount}` : '—'}</td>
                    <td><span class="acc-none">建置中</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}

      <p class="lb-note">
        <strong>準確率</strong>只計算已判定的預言，須 ≥5 筆才顯示百分比；<strong>判定率</strong>顯示我們判過多少比例，兩個數字要一起看。
        <a href="/methodology" class="lb-note-link">計分方法 →</a>
      </p>
    </>
  )}
</div>

<!-- Modal -->
<div class="pred-modal-overlay" id="pred-modal-overlay">
  <div class="pred-modal" id="pred-modal">
    <div class="pred-modal-header">
      <div>
        <div class="pred-modal-eyebrow">預言詳情</div>
        <div class="pred-modal-name" id="pred-modal-name"></div>
      </div>
      <button class="pred-modal-close" id="pred-modal-close" aria-label="關閉">✕</button>
    </div>
    <div class="pred-modal-body" id="pred-modal-body"></div>
    <div class="pred-modal-footer">
      <a class="pred-modal-more" id="pred-modal-more" href="#">前往預言家頁面 →</a>
    </div>
  </div>
</div>

<script define:vars={{ statsJson }}>
  const STATS = JSON.parse(statsJson);
  const NAME_TO_IDX = Object.fromEntries(STATS.map((s, i) => [s.name, i]));

  function openModal(idx) {
    const s = STATS[idx];
    if (!s) return;
    document.getElementById('pred-modal-name').textContent = s.name;
    document.getElementById('pred-modal-more').href = `/prophet/${encodeURIComponent(s.name)}`;

    const esc = str => String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    let html = '';
    if (s.hits.length > 0) {
      html += `<div class="pred-section"><div class="pred-section-label hit">✅ 命中預言 (${s.hits.length})</div><ul class="pred-list hit-list">${s.hits.map(h => `<li>${esc(h)}</li>`).join('')}</ul></div>`;
    }
    if (s.misses.length > 0) {
      html += `<div class="pred-section"><div class="pred-section-label miss">❌ 未命中 (${s.misses.length})</div><ul class="pred-list miss-list">${s.misses.map(m => `<li>${esc(m)}</li>`).join('')}</ul></div>`;
    }
    if (s.pending.length > 0) {
      html += `<div class="pred-section"><div class="pred-section-label pend">⏳ 待驗證 (${s.pending.length})</div><ul class="pred-list pend-list">${s.pending.map(p => `<li>${esc(p)}</li>`).join('')}</ul></div>`;
    }
    if (!html) html = '<p class="pred-empty">此預言家尚未記錄具體預言內容</p>';
    document.getElementById('pred-modal-body').innerHTML = html;
    document.getElementById('pred-modal-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    document.getElementById('pred-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.lb-row').forEach(row => {
    row.addEventListener('click', e => {
      if (e.target.closest('a')) return;
      const name = row.getAttribute('data-name');
      if (name != null && NAME_TO_IDX[name] != null) openModal(NAME_TO_IDX[name]);
    });
  });
  document.getElementById('pred-modal-close').addEventListener('click', closeModal);
  document.getElementById('pred-modal-overlay').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeModal();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // Search
  const searchInput = document.getElementById('lb-search');
  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    document.querySelectorAll('.lb-row').forEach(row => {
      const name = (row.getAttribute('data-name') || '').toLowerCase();
      row.style.display = (!q || name.includes(q)) ? '' : 'none';
    });
    if (q) document.querySelectorAll('.lb-collapsible').forEach(d => d.open = true);
  });

  // Sort
  const sortSelect = document.getElementById('lb-sort');
  sortSelect?.addEventListener('change', () => {
    const mode = sortSelect.value;
    document.querySelectorAll('.lb-tbody').forEach(tbody => {
      const rows = Array.from(tbody.querySelectorAll('.lb-row'));
      rows.sort((a, b) => {
        if (mode === 'default') return Number(a.getAttribute('data-default')) - Number(b.getAttribute('data-default'));
        return Number(b.getAttribute(`data-${mode}`) ?? 0) - Number(a.getAttribute(`data-${mode}`) ?? 0);
      });
      rows.forEach((r, i) => {
        tbody.appendChild(r);
        const rankCell = r.querySelector('.lb-rank');
        if (rankCell) {
          rankCell.textContent = (mode === 'default' && tbody.closest('.lb-section:not(.lb-collapsible)') && i < 3)
            ? ['🥇','🥈','🥉'][i]
            : String(i + 1);
        }
      });
    });
  });
</script>

<style>
  .lb-wrap { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); border-radius: 12px; padding: 0.9em 1em; color: #e2e8f0; }
  .lb-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.7em; }
  .lb-title { font-size: 0.95em; font-weight: 800; color: #f1f5f9; letter-spacing: 0.02em; }
  .lb-link { font-size: 0.72em; color: #94a3b8; text-decoration: none; }
  .lb-link:hover { color: #a78bfa; }
  .lb-empty { font-size: 0.78em; color: #475569; text-align: center; padding: 1em 0; }
  .lb-empty code { background: rgba(255,255,255,0.08); padding: 0.1em 0.3em; border-radius: 3px; font-size: 0.9em; }

  .lb-controls { display: flex; gap: 0.5em; margin: 0.7em 0 0.9em; flex-wrap: wrap; }
  .lb-search { flex: 1 1 200px; min-width: 180px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 0.5em 0.8em; color: #f1f5f9; font-size: 0.85em; outline: none; transition: border-color .15s; }
  .lb-search::placeholder { color: #64748b; }
  .lb-search:focus { border-color: #a78bfa; }
  .lb-sort { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 0.5em 0.8em; color: #f1f5f9; font-size: 0.85em; cursor: pointer; outline: none; }
  .lb-sort option { background: #0d1828; color: #f1f5f9; }
  .lb-sort:focus { border-color: #a78bfa; }

  .lb-section { margin-bottom: 1em; }
  .lb-section-head { display: flex; justify-content: space-between; align-items: center; padding: 0.5em 0.2em; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 0.3em; }
  .lb-collapsible > .lb-section-head { cursor: pointer; list-style: none; }
  .lb-collapsible > .lb-section-head::-webkit-details-marker { display: none; }
  .lb-collapsible > .lb-section-head::before { content: '▶'; font-size: 0.6em; color: #64748b; margin-right: 0.4em; transition: transform 0.2s; display: inline-block; }
  .lb-collapsible[open] > .lb-section-head::before { transform: rotate(90deg); }
  .lb-section-title { font-size: 0.82em; font-weight: 700; color: #cbd5e1; flex: 1; }
  .lb-section-count { font-size: 0.7em; color: #64748b; }

  .lb-table-wrap { overflow-x: auto; }
  .lb-table { width: 100%; border-collapse: collapse; font-size: 0.78em; }
  .lb-table th { text-align: left; color: #94a3b8; font-weight: 600; padding: 0.3em 0.5em; border-bottom: 1px solid rgba(255,255,255,0.07); white-space: nowrap; font-size: 0.85em; }
  .lb-table td { padding: 0.4em 0.5em; border-bottom: 1px solid rgba(255,255,255,0.04); color: #94a3b8; white-space: nowrap; }
  .lb-row { cursor: pointer; transition: background .1s; }
  .lb-row:hover td { background: rgba(168,85,247,0.06); }
  .lb-top1 td { background: linear-gradient(90deg, rgba(250,204,21,0.12), rgba(250,204,21,0.02)); }
  .lb-top2 td { background: linear-gradient(90deg, rgba(203,213,225,0.10), rgba(203,213,225,0.02)); }
  .lb-top3 td { background: linear-gradient(90deg, rgba(217,119,6,0.10), rgba(217,119,6,0.02)); }

  .lb-rank { color: #cbd5e1; font-weight: 700; width: 2.5em; text-align: center; }
  .lb-name { color: #f1f5f9; font-weight: 600; }
  .lb-name-link { color: #f1f5f9; text-decoration: none; transition: color .15s; }
  .lb-name-link:hover { color: #a78bfa; text-decoration: underline; }

  .lb-hit  { color: #4ade80; font-weight: 600; }
  .lb-miss { color: #f87171; }
  .lb-pend { color: #fbbf24; }
  .acc-good { color: #4ade80; font-weight: 700; }
  .acc-mid  { color: #fbbf24; font-weight: 700; }
  .acc-low  { color: #f87171; font-weight: 700; }
  .acc-none { color: #64748b; font-size: 0.9em; }
  .lb-adj { color: #94a3b8; }
  .adj-pct { font-weight: 600; }
  .adj-det { font-size: 0.82em; color: #475569; margin-left: 0.2em; }

  @media (max-width: 600px) {
    .adj-det { display: none; }
    .lb-table { font-size: 0.75em; }
    .lb-table td, .lb-table th { padding: 0.35em 0.35em; }
    .lb-hide-mobile { display: none; }
  }

  .lb-note { font-size: 0.72em; color: #64748b; margin: 0.6em 0 0; line-height: 1.55; }
  .lb-note strong { color: #94a3b8; }
  .lb-note-link { color: #a78bfa; text-decoration: none; margin-left: 0.4em; font-weight: 600; }
  .lb-note-link:hover { text-decoration: underline; }

  .lb-reverify { font-size: 0.7em; color: #64748b; margin: 0 0 0.5em; padding: 0.35em 0.6em; border-left: 2px solid #64748b; line-height: 1.4; }

  /* Modal */
  .pred-modal-overlay { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(2,10,20,0.85); backdrop-filter: blur(6px); align-items: center; justify-content: center; padding: 1rem; }
  .pred-modal-overlay.open { display: flex; }
  .pred-modal { background: #0d1828; border: 1px solid rgba(167,139,250,0.3); border-radius: 14px; width: 100%; max-width: 520px; max-height: 82vh; display: flex; flex-direction: column; box-shadow: 0 0 40px rgba(167,139,250,0.2); animation: modalIn 0.2s ease-out; }
  @keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(8px); } to { opacity: 1; transform: scale(1) translateY(0); } }
  .pred-modal-header { display: flex; align-items: flex-start; justify-content: space-between; padding: 1.1rem 1.25rem 0.9rem; border-bottom: 1px solid rgba(255,255,255,0.07); flex-shrink: 0; }
  .pred-modal-eyebrow { font-size: 0.62em; letter-spacing: 0.2em; text-transform: uppercase; color: #a78bfa; margin-bottom: 0.2rem; }
  .pred-modal-name { font-size: 1.15em; font-weight: 800; color: #f1f5f9; }
  .pred-modal-close { background: none; border: none; color: #475569; font-size: 1em; cursor: pointer; padding: 0.2em 0.4em; border-radius: 6px; transition: color 0.15s, background 0.15s; line-height: 1; }
  .pred-modal-close:hover { color: #e2e8f0; background: rgba(255,255,255,0.08); }
  .pred-modal-body { overflow-y: auto; padding: 1rem 1.25rem 1.25rem; display: flex; flex-direction: column; gap: 1.1rem; flex: 1; }
  .pred-modal-footer { padding: 0.8rem 1.25rem; border-top: 1px solid rgba(255,255,255,0.07); text-align: center; flex-shrink: 0; }
  .pred-modal-more { display: inline-block; color: #a78bfa; text-decoration: none; font-weight: 700; font-size: 0.88em; padding: 0.4em 0.9em; border: 1px solid rgba(167,139,250,0.4); border-radius: 8px; transition: all 0.15s; }
  .pred-modal-more:hover { background: rgba(167,139,250,0.15); border-color: rgba(167,139,250,0.7); }
  .pred-section-label { font-size: 0.72em; font-weight: 700; letter-spacing: 0.08em; margin-bottom: 0.5rem; }
  .pred-section-label.hit  { color: #4ade80; }
  .pred-section-label.miss { color: #f87171; }
  .pred-section-label.pend { color: #fbbf24; }
  .pred-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .pred-list li { font-size: 0.82em; color: #94a3b8; line-height: 1.55; padding: 0.4em 0.6em 0.4em 0.9em; border-radius: 6px; position: relative; }
  .pred-list li::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 60%; border-radius: 2px; }
  .hit-list li { background: rgba(74,222,128,0.05); }
  .hit-list li::before { background: #4ade80; }
  .miss-list li { background: rgba(248,113,113,0.05); }
  .miss-list li::before { background: #f87171; }
  .pend-list li { background: rgba(251,191,36,0.05); }
  .pend-list li::before { background: #fbbf24; }
  .pred-empty { font-size: 0.8em; color: #334155; text-align: center; padding: 1rem 0; margin: 0; }
</style>
