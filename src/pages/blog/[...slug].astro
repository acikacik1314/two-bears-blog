---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';
import BlogPost from '../../layouts/BlogPost.astro';

// Minimum chars before a marker to qualify as a meaningful summary
const MIN_SUMMARY = 200;

function findTranscriptMarker(body: string): { marker: string; index: number } | null {
	for (const marker of ['\n## 逐字稿', '\n## 影片逐字稿']) {
		const idx = body.indexOf(marker);
		if (idx > MIN_SUMMARY) return { marker, index: idx };
	}
	return null;
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter(p => !p.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const body = post.body ?? '';
const found = findTranscriptMarker(body);
const hasTranscript = found !== null;

let summaryHtml = '';
if (found) {
	const summaryMd = body.slice(0, found.index);
	const result = await unified()
		.use(remarkParse)
		.use(remarkGfm)
		.use(remarkRehype)
		.use(rehypeStringify)
		.process(summaryMd);
	summaryHtml = String(result);
}

const { Content } = hasTranscript ? { Content: null } : await render(post);
---

<BlogPost {...post.data} transcriptSlug={hasTranscript ? post.id : undefined}>
	{hasTranscript
		? <Fragment set:html={summaryHtml} />
		: Content && <Content />
	}
</BlogPost>
