---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = '聯絡兩隻熊 ｜ Contact';
const description = '合作邀約、來信交流、粉絲團私訊：兩隻熊的旅遊記事與未來人預言家聯絡方式。';

const FB_URL = 'https://www.facebook.com/profile.php?id=61570677963544';
const YT_URL = 'https://www.youtube.com/@twobears';
const EMAIL = 'acikacik@gmail.com';
---

<html lang="zh-TW">
<head>
  <BaseHead title={title} description={description} />
  <style is:global>
    html body { background: #020a14; color: #e2e8f0; font-family: 'Noto Sans TC', sans-serif; }
    .contact-page { min-height: 100vh; padding: 6rem 1.5rem 4rem; }
    .contact-wrap { max-width: 720px; margin: 0 auto; }
    .contact-eyebrow {
      font-size: .75rem; letter-spacing: .25em; text-transform: uppercase;
      color: #00f5ff; margin-bottom: 1rem; text-align: center;
    }
    .contact-page h1 {
      font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; margin: 0 0 1.5rem; text-align: center;
      background: linear-gradient(135deg, #fff 0%, #00f5ff 50%, #a78bfa 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; color: transparent;
    }
    .contact-intro { color: #cbd5e1; font-size: 1.05rem; line-height: 1.8; text-align: center; margin-bottom: 2.5rem; }
    .contact-list { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
    .contact-item {
      display: flex; align-items: center; gap: 1rem;
      padding: 1.25rem 1.5rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(0,245,255,0.15);
      border-radius: 14px;
      transition: border-color .2s, background .2s;
    }
    .contact-item:hover { border-color: rgba(0,245,255,0.4); background: rgba(255,255,255,0.05); }
    .contact-icon { font-size: 1.6rem; }
    .contact-body { flex: 1; }
    .contact-label { font-weight: 700; color: #e2e8f0; margin-bottom: .25rem; }
    .contact-value a { color: #00f5ff; text-decoration: none; word-break: break-all; }
    .contact-value a:hover { text-decoration: underline; }
    .contact-note { color: #94a3b8; font-size: .9rem; margin-top: .3rem; }
    .contact-outro {
      margin-top: 3rem; padding: 1.5rem; text-align: center;
      color: #94a3b8; font-size: .95rem; line-height: 1.8;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
  </style>
</head>
<body class="contact-page">
  <Header />
  <main class="contact-wrap">
    <p class="contact-eyebrow">— Contact —</p>
    <h1>和兩隻熊說聲嗨 🐻🐻</h1>
    <p class="contact-intro">
      歡迎品牌合作、業配邀約、採訪詢問、讀者回饋，或單純想分享你最近看到的預言、旅遊心得。
      下面幾個管道都可以找到我們，<strong>粉絲團私訊回覆最快</strong>，Email 則適合有附件或完整提案的來信。
    </p>

    <ul class="contact-list">
      <li class="contact-item">
        <span class="contact-icon">💬</span>
        <div class="contact-body">
          <div class="contact-label">Facebook 粉絲團</div>
          <div class="contact-value"><a href={FB_URL} target="_blank" rel="noopener">{FB_URL}</a></div>
          <div class="contact-note">多數讀者習慣直接私訊粉專，回覆最即時。</div>
        </div>
      </li>
      <li class="contact-item">
        <span class="contact-icon">✉️</span>
        <div class="contact-body">
          <div class="contact-label">Email</div>
          <div class="contact-value"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
          <div class="contact-note">合作提案、媒體邀訪、長文詢問建議走 Email。</div>
        </div>
      </li>
      <li class="contact-item">
        <span class="contact-icon">▶️</span>
        <div class="contact-body">
          <div class="contact-label">YouTube 頻道</div>
          <div class="contact-value"><a href={YT_URL} target="_blank" rel="noopener">{YT_URL}</a></div>
          <div class="contact-note">訂閱頻道，追蹤最新預言觀測與旅遊影片。</div>
        </div>
      </li>
    </ul>

    <p class="contact-outro">
      我們是獨立經營的小團隊，所有來信都會親自閱讀。
      如果你是品牌或公關公司，歡迎在信件開頭註明「合作邀約」並附上簡短背景，有助於我們更快回覆。
    </p>
  </main>
  <Footer />
</body>
</html>
