---
export const prerender = false;
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTACard from '../components/CTACard.astro';
import PredictionPoll from '../components/PredictionPoll.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead
      title={`未來人預言家 Podcast | ${SITE_TITLE}`}
      description="兩隻熊的未來人預言家 Podcast — 解讀末日預言、台海局勢、靈性分析"
      imageUrl="https://twobears.vercel.app/images/podcast-cover.jpg"
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "兩隻熊的未來人預言家",
      "description": "兩隻熊的未來人預言家 Podcast — 解讀末日預言、台海局勢、靈性分析",
      "url": "https://twobears.vercel.app/podcast",
      "image": "https://twobears.vercel.app/images/podcast-cover.jpg",
      "webFeed": "https://anchor.fm/s/11310a874/podcast/rss",
      "author": { "@type": "Person", "name": "兩隻熊" }
    })} />
  </head>
  <body class="pod-page">
    <Header />
    <main class="pod-main">

      <!-- ── HERO ── -->
      <div class="pod-hero">
        <div class="pod-hero-backdrop"></div>
        <div class="pod-hero-inner">
          <img
            class="pod-cover"
            src="/images/two-bears-avatar.jpg"
            alt="兩隻熊"
          />
          <div class="pod-hero-text">
            <span class="pod-label">PODCAST</span>
            <h1 class="pod-title">未來人預言家</h1>
            <p class="pod-desc">末日預言・台海局勢・靈性分析・XRP<br/>帶你直擊各大預言家的第一手話語</p>
            <div class="pod-meta">
              <span class="pod-creator">🐻 兩隻熊</span>
              <span class="pod-dot">·</span>
              <span id="pod-total">載入中…</span>
            </div>
            <div class="pod-hero-btns">
              <a
                class="pod-spotify-btn"
                href="https://open.spotify.com/show/033nZopH7VWW9G0RdIchZG"
                target="_blank" rel="noopener"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                </svg>
                在 Spotify 收聽
              </a>
              <a
                class="pod-apple-btn-sm"
                href="https://podcasts.apple.com/tw/podcast/id1896823711"
                target="_blank" rel="noopener"
              >Apple Podcasts</a>
              <a
                class="pod-apple-btn-sm"
                href="https://anchor.fm/s/11310a874/podcast/rss"
                target="_blank" rel="noopener"
              >
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true" style="opacity:.7;flex-shrink:0">
                  <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
                </svg>
                RSS 訂閱
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Loading / Error ── -->
      <div class="pod-loading" id="pod-loading">
        <span class="pod-spinner"></span> 載入集數中…
      </div>
      <div class="pod-error" id="pod-error" style="display:none">
        ⚠️ 無法載入節目，請重新整理頁面。
      </div>

      <!-- ── Episodes ── -->
      <div id="pod-content" style="display:none" class="pod-content">

        <div class="pod-ep-header">
          <h2 class="pod-ep-title">所有集數 <span id="pod-ep-count" class="pod-ep-count"></span></h2>
        </div>

        <div class="pod-list" id="pod-list"></div>

      </div>

    <!-- CTA pool：隱藏在此，JS cloneNode 插入清單 -->
    <div id="cta-pool" style="display:none" aria-hidden="true">
      <CTACard
        emoji="🔮"
        text="預言說 2026 財富要大洗牌——那你手上那支股票呢？輸入代號，讓 AI 把未來人的預言疊在它的財報上，算給你看"
        href="/oracle"
        btnText="啟動時空觀測 →"
      />
      <CTACard
        emoji="🎋"
        text="看完世界的命運，要不要看你自己的？賽博神社每日御神籤——今天你的財運、行動指令，一抽就知道"
        href="/omikuji"
        btnText="抽今天這支籤 →"
      />
      <CTACard
        emoji="🔮"
        text="不想只信一個人？比格斯、帕克、未來人，同一件事我們攤開比對給你看"
        href="/category/預言"
        btnText="看交叉比對 →"
      />
    </div>

    </main>
    <PredictionPoll />

    <div class="pod-kofi">
      <span class="pod-kofi-icon">☕</span>
      <div class="pod-kofi-text">
        <div class="pod-kofi-title">喜歡收聽未來人預言家？</div>
        <div class="pod-kofi-desc">贊助一杯咖啡，讓兩隻熊繼續為你整理預言情報</div>
      </div>
      <a href="https://ko-fi.com/twobear2" target="_blank" rel="noopener" class="pod-kofi-btn">☕ 贊助支持</a>
    </div>
    <Footer />
  </body>
</html>

<script>
  interface ProphetInfo { label: string; color: string; bg: string; image?: string; icon: string; }

  const PROPHETS: Record<string, ProphetInfo> = {
    '比格斯':        { label: '比格斯',        color: '#f59e0b', bg: 'rgba(245,158,11,.15)', image: '/biggs-prophet.png',                    icon: '✝️' },
    '帕克':          { label: '帕克',          color: '#3b82f6', bg: 'rgba(59,130,246,.15)', image: '/prophets/parker.png',                icon: '🔭' },
    '麥克蒙尼格':    { label: '麥克蒙尼格',    color: '#10b981', bg: 'rgba(16,185,129,.15)', image: '/prophets/mcmoneagle.png',            icon: '🧠' },
    '摩普萊':        { label: '摩普萊',        color: '#ef4444', bg: 'rgba(239,68,68,.15)',  image: '/prophets/mor-plai.png',              icon: '🌏' },
    '波蘭預言家':    { label: '波蘭預言家',    color: '#8b5cf6', bg: 'rgba(139,92,246,.15)',                                                 icon: '🇵🇱' },
    '英國神算':      { label: '英國神算',      color: '#06b6d4', bg: 'rgba(6,182,212,.15)',                                                  icon: '🔮' },
    '巴夏':          { label: '巴夏',          color: '#0ea5e9', bg: 'rgba(14,165,233,.15)', image: '/prophets/darryl-anka.jpg',             icon: '👽' },
    '薩洛梅':        { label: '薩洛梅',        color: '#ec4899', bg: 'rgba(236,72,153,.15)', image: '/prophets/athos-salome.webp',           icon: '🌸' },
    'KFK':           { label: 'KFK',           color: '#f97316', bg: 'rgba(249,115,22,.15)', image: '/prophets/kfk.webp',                    icon: '⏰' },
    'Troy Black':    { label: 'Troy Black',    color: '#84cc16', bg: 'rgba(132,204,22,.15)', image: '/prophets/troy-black.webp',             icon: '📖' },
    '鄭博見':        { label: '鄭博見',        color: '#a855f7', bg: 'rgba(168,85,247,.15)', image: '/prophets/zheng-bojian.jpg',            icon: '💎' },
    'Paul Begley':   { label: 'Paul Begley',   color: '#ef4444', bg: 'rgba(239,68,68,.15)',  image: '/prophets/paul-begley.webp',            icon: '⚡' },
    '阿南德':        { label: '阿南德',        color: '#f59e0b', bg: 'rgba(245,158,11,.15)', image: '/prophets/abhigya-anand.jpg',           icon: '🌟' },
    '權朗':          { label: '權朗',          color: '#14b8a6', bg: 'rgba(20,184,166,.15)', image: '/prophets/quan-lang.jpg',               icon: '🀄' },
    '朱迪海文利':    { label: '朱迪海文利',    color: '#6366f1', bg: 'rgba(99,102,241,.15)', image: '/prophets/judy-hevenly.jpg',            icon: '🌌' },
    '國分玲':        { label: '國分玲',        color: '#f43f5e', bg: 'rgba(244,63,94,.15)',                                                  icon: '🌸' },
    'Omnec Onec':    { label: 'Omnec Onec',    color: '#8b5cf6', bg: 'rgba(139,92,246,.15)', image: '/prophets/omnec-onec.jpg',              icon: '🛸' },
    'Martin Armstrong': { label: 'Martin Armstrong', color: '#64748b', bg: 'rgba(100,116,139,.15)', image: '/prophets/martin-armstrong.png', icon: '📊' },
    'Jucelino':      { label: 'Jucelino',      color: '#22c55e', bg: 'rgba(34,197,94,.15)',                                                  icon: '🌊' },
    'Jessica Adams': { label: 'Jessica Adams', color: '#a855f7', bg: 'rgba(168,85,247,.15)',                                                 icon: '⭐' },
    'J.D. Farag':    { label: 'J.D. Farag',    color: '#3b82f6', bg: 'rgba(59,130,246,.15)', image: '/prophets/jd-farag.webp',              icon: '✝️' },
    'Adam Archon':   { label: 'Adam Archon',   color: '#0ea5e9', bg: 'rgba(14,165,233,.15)',                                                 icon: '🌀' },
    '袁天罡與李淳風': { label: '袁天罡與李淳風', color: '#78350f', bg: 'rgba(120,53,15,.15)',                                                icon: '📜' },
    '倪海廈':        { label: '倪海廈',        color: '#047857', bg: 'rgba(4,120,87,.15)',                                                   icon: '☯️' },
    'Sadhguru':      { label: 'Sadhguru',      color: '#854d0e', bg: 'rgba(133,77,14,.15)',  image: '/prophets/sadhguru.jpg',                icon: '🙏' },
    'Clif High':     { label: 'Clif High',     color: '#0369a1', bg: 'rgba(3,105,161,.15)',  image: '/prophets/clif-high.jpg',               icon: '💻' },
    'Lee Carroll':   { label: 'Lee Carroll',   color: '#7c3aed', bg: 'rgba(124,58,237,.15)', image: '/prophets/lee-carroll.jpg',             icon: '✨' },
    'Jonathan Cahn': { label: 'Jonathan Cahn', color: '#b45309', bg: 'rgba(180,83,9,.15)',   image: '/prophets/jonathan-cahn.webp',          icon: '✡️' },
    'Joseph Tittel': { label: 'Joseph Tittel', color: '#0891b2', bg: 'rgba(8,145,178,.15)',  image: '/prophets/joseph-tittel.jpg',           icon: '🔮' },
    'Jackowski':     { label: 'Jackowski',     color: '#4f46e5', bg: 'rgba(79,70,229,.15)',  image: '/prophets/jackowski.jpg',               icon: '🇵🇱' },
    'amanda-grace':  { label: 'Amanda Grace',  color: '#db2777', bg: 'rgba(219,39,119,.15)', image: '/prophets/amanda-grace.jpg',            icon: '🕊️' },
    'Jennifer LeClaire': { label: 'Jennifer LeClaire', color: '#9333ea', bg: 'rgba(147,51,234,.15)', image: '/prophets/jennifer-leclaire.webp', icon: '🔥' },
    'David the Medium': { label: 'David the Medium', color: '#0f766e', bg: 'rgba(15,118,110,.15)', image: '/prophets/david-the-medium.webp', icon: '👁️' },
    '小孟老師':      { label: '小孟老師',      color: '#0ea5e9', bg: 'rgba(14,165,233,.15)', image: '/prophets/xiaomeng.webp',               icon: '🃏' },
    '廖美然':        { label: '廖美然',        color: '#7c3aed', bg: 'rgba(124,58,237,.15)', image: '/prophets/liao-meiran.webp',            icon: '🔮' },
    'Joni Patry':    { label: 'Joni Patry',    color: '#d97706', bg: 'rgba(217,119,6,.15)',  image: '/prophets/joni-patry.webp',             icon: '⭐' },
    '蔡上機':        { label: '蔡上機',        color: '#475569', bg: 'rgba(71,85,105,.15)',                                                  icon: '📿' },
    '杜金龍':        { label: '杜金龍',        color: '#0369a1', bg: 'rgba(3,105,161,.15)',                                                  icon: '📈' },
    '張盛舒':        { label: '張盛舒',        color: '#1f2937', bg: 'rgba(31,41,55,.15)',                                                   icon: '⭐' },
    '伊莉莎白·愛普爾': { label: '伊莉莎白·愛普爾', color: '#6d28d9', bg: 'rgba(109,40,217,.15)', image: '/elizabeth-april-prophet.jpg',     icon: '✨' },
    '水森太陽':      { label: '水森太陽',      color: '#0369a1', bg: 'rgba(3,105,161,.15)',  image: '/mizumori-prophet.jpg',                 icon: '☀️' },
  };

  function getProphet(name: string): ProphetInfo {
    return PROPHETS[name] ?? { label: name || '', color: '#64748b', bg: 'rgba(100,116,139,.15)', icon: '🔮' };
  }

  function detectProphet(title: string): string {
    if (/比格斯|biggs/i.test(title))                                                   return '比格斯';
    if (/帕克|parker/i.test(title))                                                    return '帕克';
    if (/麥克蒙尼格|mcmoneagle|遙視員|遙視者|CIA遙視/i.test(title))                    return '麥克蒙尼格';
    if (/摩普萊|普萊醫生|หมอปลาย/i.test(title))                                       return '摩普萊';
    if (/波蘭預言家/i.test(title))                                                     return '波蘭預言家';
    if (/英國神算/i.test(title))                                                       return '英國神算';
    if (/巴夏|bashar|darryl.?anka/i.test(title))                                      return '巴夏';
    if (/薩洛梅|salomé|athos.?salom/i.test(title))                                    return '薩洛梅';
    if (/troy.?black/i.test(title))                                                   return 'Troy Black';
    if (/鄭博見|dato.?anthony/i.test(title))                                          return '鄭博見';
    if (/KFK|ＫＦＫ/i.test(title))                                                    return 'KFK';
    if (/paul.?begley|保羅.?貝格利/i.test(title))                                     return 'Paul Begley';
    if (/abhigya|阿南德/i.test(title))                                                return '阿南德';
    if (/權朗/i.test(title))                                                          return '權朗';
    if (/朱迪|judy.?hev/i.test(title))                                                return '朱迪海文利';
    if (/國分玲|kokubun/i.test(title))                                                return '國分玲';
    if (/omnec.?onec/i.test(title))                                                   return 'Omnec Onec';
    if (/martin.?armstrong|馬丁.?阿姆斯特朗|馬丁.?阿姆斯壯/i.test(title))            return 'Martin Armstrong';
    if (/jucelino/i.test(title))                                                      return 'Jucelino';
    if (/jessica.?adams/i.test(title))                                                return 'Jessica Adams';
    if (/j\.?d\.?.?farag|JD牧師/i.test(title))                                        return 'J.D. Farag';
    if (/adam.?archon/i.test(title))                                                  return 'Adam Archon';
    if (/袁天罡|李淳風|推背圖/i.test(title))                                           return '袁天罡與李淳風';
    if (/倪海廈/i.test(title))                                                        return '倪海廈';
    if (/sadhguru|薩古魯|賽古魯/i.test(title))                                        return 'Sadhguru';
    if (/clif.?high/i.test(title))                                                    return 'Clif High';
    if (/lee.?carroll|克里昂/i.test(title))                                           return 'Lee Carroll';
    if (/jonathan.?cahn|喬納森.?卡恩/i.test(title))                                   return 'Jonathan Cahn';
    if (/joseph.?tittel|喬瑟夫.?蒂特爾/i.test(title))                                 return 'Joseph Tittel';
    if (/jackowski|雅克沃斯基|克日什托夫/i.test(title))                                return 'Jackowski';
    if (/amanda.?grace|阿曼達.?格雷斯/i.test(title))                                  return 'amanda-grace';
    if (/jennifer.?leclaire|leclaire|詹妮福/i.test(title))                            return 'Jennifer LeClaire';
    if (/david.the.medium|david.*medium|靈媒.*大衛|大衛.*靈媒|通靈.*大衛|大衛.*通靈/i.test(title)) return 'David the Medium';
    if (/小孟/i.test(title))                                                          return '小孟老師';
    if (/廖美然|觀世音.*廖/i.test(title))                                              return '廖美然';
    if (/joni.?patry|喬尼.?帕特/i.test(title))                                       return 'Joni Patry';
    if (/蔡上機/i.test(title))                                                        return '蔡上機';
    if (/杜金龍/i.test(title))                                                        return '杜金龍';
    if (/張盛舒/i.test(title))                                                        return '張盛舒';
    if (/elizabeth.?april|伊莉莎白.*愛普爾/i.test(title))                             return '伊莉莎白·愛普爾';
    if (/水森太陽|mizumori/i.test(title))                                             return '水森太陽';
    return '';
  }

  function fmtDate(s: string) {
    if (!s) return '';
    return new Date(s).toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
  }

  function fmtDur(s: string) {
    if (!s) return '';
    if (s.includes(':')) return s.startsWith('00:') ? s.slice(3) : s;
    const n = parseInt(s);
    if (isNaN(n)) return '';
    return `${Math.floor(n / 60)}:${(n % 60).toString().padStart(2, '0')}`;
  }

  let allEpisodes: any[] = [];

  function renderList(filter: string) {
    const list = document.getElementById('pod-list')!;
    const eps = filter === 'all'
      ? allEpisodes
      : allEpisodes.filter(ep => ep._prophet === filter);

    list.innerHTML = '';

    if (!eps.length) {
      list.innerHTML = '<div class="pod-empty">沒有找到相關集數</div>';
      return;
    }

    eps.forEach((ep: any) => {
      const p = getProphet(ep._prophet);
      const dur = fmtDur(ep.duration);
      const date = fmtDate(ep.date);

      const card = document.createElement('div');
      card.className = 'pod-card';
      card.style.setProperty('--accent', ep._prophet ? p.color : '#64748b');
      const avatarInitial = p.label ? p.label[0] : '?';
      card.innerHTML = `
        <div class="pod-card-top">
          <div class="pod-avatar" style="background:${p.color}25;border:2px solid ${p.color}80">
            ${p.image ? `<img class="pod-avatar-img" src="${p.image}" alt="${p.label}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">` : ''}
            <span class="pod-avatar-initial" style="color:${p.color}${p.image ? ';display:none' : ''}">${avatarInitial}</span>
          </div>
          <div class="pod-card-info">
            <div class="pod-card-meta">
              ${p.label ? `<span class="pod-card-prophet" style="color:${p.color}">${p.label}</span>` : ''}
              ${date ? `<span class="pod-card-date">${date}</span>` : ''}
              ${dur  ? `<span class="pod-card-dur">⏱ ${dur}</span>` : ''}
            </div>
            <div class="pod-card-num">EP ${ep.num ?? ep._idx + 1}</div>
            <h3 class="pod-card-title">${ep.title}</h3>
          </div>
        </div>
        <div class="pod-card-player">
          ${ep.spotifyEmbedUrl ? `
          <div class="pod-player-sticky">
            <iframe src="${ep.spotifyEmbedUrl}" width="100%" height="152" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" style="border-radius:8px;border:none;display:block"></iframe>
          </div>
          ` : `
          <a href="${ep.appleUrl}" target="_blank" rel="noopener" class="pod-apple-link">前往收聽</a>
          `}
          ${ep.description ? `
          <button class="pod-transcript-btn is-open" aria-expanded="true" aria-label="收合文字版">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
            </svg>
            收合文字版
            <svg class="pod-btn-arrow" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="pod-transcript">${ep.description}</div>` : ''}
        </div>
      `;

      if (ep.description) {
        card.querySelector('.pod-transcript-btn')?.addEventListener('click', (e) => {
          e.stopPropagation();
          const btn = e.currentTarget as HTMLButtonElement;
          const transcript = btn.closest('.pod-card-player')!.querySelector('.pod-transcript') as HTMLElement;
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          if (transcript) transcript.hidden = isOpen;
          btn.setAttribute('aria-expanded', String(!isOpen));
          btn.classList.toggle('is-open', !isOpen);
          for (const node of Array.from(btn.childNodes)) {
            if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
              node.textContent = isOpen ? ' 展開這集的文字版 ' : ' 收合文字版 ';
              break;
            }
          }
        });
      }

      list.appendChild(card);
    });

    // 插入 CTA 引導卡片（從 cta-pool clone，不改原始節點）
    const pool = document.getElementById('cta-pool');
    if (pool && eps.length > 0) {
      const ctas = Array.from(pool.children) as HTMLElement[];
      const podCards = Array.from(list.querySelectorAll<HTMLElement>('.pod-card'));
      const N = podCards.length;

      // ① 第 2 集之後（最多人看到，放最強的）
      if (N >= 2) podCards[1].after(ctas[0].cloneNode(true));

      // ② 中段（重新抓清單，避免 ① 插入後 index 錯位）
      if (N >= 4) {
        const mid = Math.floor(N / 2);
        const updated = Array.from(list.querySelectorAll<HTMLElement>('.pod-card'));
        if (updated[mid]) updated[mid].after(ctas[1].cloneNode(true));
      }

      // ③ 清單結尾
      list.appendChild(ctas[2].cloneNode(true));
    }
  }

  const CACHE_KEY = 'pod-rss-v2';
  const CACHE_TTL = 5 * 60 * 1000; // 5 分鐘

  function stripHtml(s: string) {
    return s ? s.replace(/<[^>]+>/g, ' ') : '';
  }

  function applyData(d: any) {
    allEpisodes = (d.episodes as any[]).map((ep: any, i: number) => ({
      ...ep,
      _idx: i,
      _prophet: detectProphet(ep.title + ' ' + stripHtml(ep.description || '')),
    }));
    const coverEl = document.querySelector<HTMLImageElement>('.pod-cover');
    if (coverEl && d.coverImage) coverEl.src = d.coverImage;
    const totalEl = document.getElementById('pod-total');
    if (totalEl) totalEl.textContent = `${allEpisodes.length} 集`;
    const countEl = document.getElementById('pod-ep-count');
    if (countEl) countEl.textContent = `${allEpisodes.length} 集`;
    renderList('all');
  }

  async function fetchFresh() {
    const r = await fetch('/api/podcast-rss');
    if (!r.ok) throw new Error('fetch');
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data: d })); } catch {}
    return d;
  }

  async function init() {
    const loadingEl = document.getElementById('pod-loading')!;
    const errorEl   = document.getElementById('pod-error')!;
    const contentEl = document.getElementById('pod-content')!;

    let usedCache = false;
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      let cached = raw ? JSON.parse(raw) : null;
      const stale = !cached || (Date.now() - cached.ts > CACHE_TTL);

      if (cached) {
        try {
          applyData(cached.data);
          loadingEl.style.display = 'none';
          contentEl.style.display = 'block';
          usedCache = true;
        } catch {
          // 格式壞掉，清除後走 fresh fetch
          localStorage.removeItem(CACHE_KEY);
          cached = null;
        }
      }

      if (stale || !cached) {
        const d = await fetchFresh();
        applyData(d);
        if (!usedCache) {
          loadingEl.style.display = 'none';
          contentEl.style.display = 'block';
        }
      }
    } catch {
      if (contentEl.style.display !== 'block') {
        loadingEl.style.display = 'none';
        errorEl.style.display = 'block';
      }
    }
  }

  init();
</script>

