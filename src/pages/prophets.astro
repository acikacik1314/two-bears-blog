---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProphetStats } from '../utils/prophetStats';
import { getProfileOrFallback } from '../data/prophets';

const allStats = await getProphetStats();
const withPosts = allStats.filter(s => s.postCount > 0);

const title = '預言家命中率追蹤｜兩隻熊';
const description = `追蹤 ${allStats.length} 位預言家的命中率，基於實際預言紀錄計算，持續更新。`;
---

<style is:global>
html body { background: #0f172a; color: #e2e8f0; }
</style>

<html lang="zh-Hant">
<head>
  <BaseHead title={title} description={description} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": "https://twobear.blog/prophets",
  })} />
</head>
<body>
  <Header />

  <main class="pg-wrap">
    <div class="pg-head">
      <h1 class="pg-title">🔮 預言家命中率排行</h1>
      <p class="pg-sub">依實際預言記錄計算，命中須附查證依據才計入分數</p>
      <p class="pg-reverify">🔍 我們正在逐條填寫命中的查證依據，只有附上理由的才計入分數——整理進行中，數字還會繼續更新</p>
    </div>

    <div class="card-grid">
      {withPosts.map((s, i) => {
        const p = getProfileOrFallback(s.id);
        const rank = i + 1;
        const accClass = s.accuracy !== null && s.accuracy >= 80 ? ' great'
                       : s.accuracy !== null && s.accuracy >= 60 ? ' good' : '';
        return (
          <a href={`/prophet/${encodeURIComponent(s.id)}`} class="prophet-card">
            <div class="card-rank">{rank}</div>
            <div class="card-avatar" style={`background:linear-gradient(135deg,${p.color} 0%,#0f172a 100%);border-color:${p.color}`}>
              <span class="card-emoji">{p.emoji}</span>
            </div>
            <div class="card-name">{p.name}</div>
            <div class="card-origin">{p.origin}</div>
            {s.accuracy !== null ? (
              <div class={`card-acc${accClass}`}>{s.accuracy}%</div>
            ) : s.verified > 0 ? (
              <div class="card-acc card-acc-raw">{s.reasonedHitCount}/{s.verified}<span class="card-acc-label"> 已判定</span></div>
            ) : (
              <div class="card-acc muted-acc">—</div>
            )}
            <div class="card-stats">
              <span class="cs-hit">✅ {s.hitCount}</span>
              <span class="cs-miss">❌ {s.missCount}</span>
              <span class="cs-pend">⏳ {s.pendingCount}</span>
            </div>
            <div class="card-adj">
              判定率 {s.adjudicationRate !== null ? `${s.adjudicationRate}%` : '—'}
              <span class="card-adj-det">（{s.verified}/{s.totalPredictions}）</span>
            </div>
            <div class="card-meta">{s.postCount} 篇文章・{s.verified} 則已驗</div>
          </a>
        );
      })}
    </div>
    <p class="pg-note">準確率只計算已判定的預言；判定率顯示我們判過多少比例，這兩個數字要一起看。<a href="/methodology" class="pg-note-link">計分方法 →</a></p>
  </main>

  <Footer />
</body>
</html>

<style>
.pg-wrap {
  max-width: 960px;
  margin: 0 auto;
  padding: 2.5em 1.5em 4em;
}
.pg-head { text-align: center; margin-bottom: 2.5em; }
.pg-title { font-size: 2em; font-weight: 900; color: #f1f5f9; margin: 0 0 .4em; }
.pg-sub { font-size: .88em; color: #64748b; margin: 0; }

.section-label {
  font-size: .72em;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #94a3b8;
  margin: 0 0 1em;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1em;
}

.prophet-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5em;
  padding: 1.4em 1em;
  border-radius: 14px;
  text-decoration: none;
  border: 1px solid rgba(255,255,255,.07);
  background: rgba(255,255,255,.03);
  transition: border-color .2s, background .2s, transform .15s;
  position: relative;
  cursor: pointer;
}
.prophet-card:hover {
  border-color: rgba(168,85,247,.4);
  background: rgba(168,85,247,.06);
  transform: translateY(-2px);
}
.card-rank {
  position: absolute;
  top: .7em;
  left: .8em;
  font-size: .65em;
  font-weight: 900;
  color: #a78bfa;
  background: rgba(167,139,250,.15);
  border-radius: 50%;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  border: 2px solid #a855f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.card-emoji { font-size: 2em; }

.card-name {
  font-size: 1.05em;
  font-weight: 800;
  color: #f1f5f9;
  text-align: center;
}
.card-origin {
  font-size: .68em;
  color: #475569;
  text-align: center;
}

.card-acc {
  font-size: 1.6em;
  font-weight: 900;
  color: #fbbf24;
}
.card-acc.great { color: #4ade80; }
.card-acc.good  { color: #a3e635; }
.card-acc-raw { font-size: 1.1em; color: #94a3b8; }
.card-acc-label { font-size: .55em; color: #64748b; font-weight: 600; }
.muted-acc { font-size: .8em; color: #475569; font-weight: 600; }

.card-stats {
  display: flex;
  gap: .6em;
  font-size: .72em;
}
.cs-hit  { color: #4ade80; }
.cs-miss { color: #f87171; }
.cs-pend { color: #fbbf24; }

.card-meta {
  font-size: .62em;
  color: #334155;
  text-align: center;
}

.card-adj {
  font-size: .65em;
  color: #475569;
  text-align: center;
}
.card-adj-det { color: #334155; }

.pg-note {
  font-size: .72em;
  color: #475569;
  margin: 1em 0 0;
  line-height: 1.55;
}
.pg-note-link {
  color: #7c3aed;
  text-decoration: none;
  margin-left: .3em;
  font-weight: 600;
}
.pg-note-link:hover { color: #a78bfa; }
.pg-reverify {
  font-size: .75em;
  color: #64748b;
  margin: .6em 0 0;
  border: 1px solid rgba(100,116,139,.25);
  border-radius: 8px;
  padding: .5em .9em;
  display: inline-block;
}
</style>
